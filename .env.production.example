# Copy to an access-controlled deployment environment file and set real paths.
APP_ENV=production
PUBLIC_HOSTNAME=students.example.gov.sg
PRODUCTION_HTTP_BIND_ADDRESS=0.0.0.0
PRODUCTION_HTTPS_BIND_ADDRESS=0.0.0.0
TLS_CERTIFICATE_HOST_PATH=/etc/sps-student-dashboard/tls/fullchain.pem
TLS_PRIVATE_KEY_HOST_PATH=/etc/sps-student-dashboard/tls/private-key.pem
