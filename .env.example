APP_ENV=development
STAGING_BIND_ADDRESS=127.0.0.1
DATABASE_URL=postgresql+psycopg://sps_runtime:change-this-runtime-password@db:5432/sps_dashboard
DATABASE_ADMIN_URL=postgresql+psycopg://sps_app:change-this-admin-password@db:5432/sps_dashboard
DATABASE_RUNTIME_PASSWORD=change-this-runtime-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=sps-student-dashboard
JWT_AUDIENCE=sps-browser
ACCESS_TOKEN_MINUTES=15
BOOTSTRAP_USERNAME=bootstrap-admin
BOOTSTRAP_PASSWORD=change-this-on-first-run
POSTGRES_PASSWORD=change-this-admin-password
APP_ENCRYPTION_KEY=replace-with-a-fernet-compatible-32-byte-base64-key
